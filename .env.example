# RepoBrain Configuration (Offline / Static Knowledge Engine Mode)
RB_MODE=static
RB_ASK_TIMEOUT_SECONDS=120

# Database Configuration
POSTGRES_DB=alamia_ott
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
DATABASE_URI=postgres://postgres:postgres_dev_password@localhost:5432/alamia_ott

# MinIO Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_ENDPOINT=http://localhost:29000
MINIO_BUCKET_RAW=raw-uploads
MINIO_BUCKET_HLS=hls-media

# Payload CMS & Next.js Subdomains (Cloudflare Tunnel Target: alamia-network)
PAYLOAD_SECRET=dev_secret_key_change_in_production
NEXT_PUBLIC_SERVER_URL=https://cmm.alamiaai.com
NEXT_PUBLIC_CMS_URL=https://cmmadmin.alamiaai.com
