{
  "name": "alamia-ott-cms",
  "version": "1.0.0",
  "description": "Payload CMS for Alamia OTT / RK Portal",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx src/server.ts",
    "build:payload": "payload build",
    "build:server": "tsc",
    "build": "cross-env NODE_ENV=production npm run build:payload && npm run build:server",
    "start": "cross-env NODE_ENV=production node dist/server.js"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "payload": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
